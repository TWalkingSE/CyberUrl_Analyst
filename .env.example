# === CyberURL Analyst — Chaves de API ===
# Copie este arquivo para .env e preencha suas chaves.
# NUNCA versione o arquivo .env!

# VirusTotal API v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# URLScan.io API — https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# Google Safe Browsing API v4 — https://console.cloud.google.com/
GOOGLE_SAFE_BROWSING_API_KEY=

# PhishTank API — https://phishtank.org/api_register.php
PHISHTANK_API_KEY=

# URLhaus Auth-Key (opcional) — https://urlhaus.abuse.ch/api/#account
URLHAUS_AUTH_KEY=

# Senha de acesso à interface (opcional) — deixe vazio para acesso livre
CYBERURL_PASSWORD=
